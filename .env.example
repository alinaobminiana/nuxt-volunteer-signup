# Choose your email settings before opening volunteer registration.
# Start with a local .env copy; provide your own passwords and provider credentials there.
# Configure sending with docs/email-setup.md, or start in development with MAIL_MODE=log for local email previews.

APP_URL=http://localhost:3000 # Origin where volunteers complete the signup form; include a non-default port if used.
HOST=127.0.0.1 # Local binding by default. Change this if your deployment requires another interface.
PORT=3000 # Listening port for the production server; development uses the framework config.
DB_PATH=.data/app.sqlite # Volunteer roles, availability, and instruction emails; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # Protect the operator who can review volunteer signups: username admin, random password of 16 or more characters.
MAIL_MODE=sandbox # Keep volunteer instructions in sandbox while setting up; production sends email; log works locally in development.
MAIL_FROM=sender@example.com # Sender identity for volunteer instructions; the domain must be verified in Mailtrap for production.
MAILTRAP_PRODUCTION_TOKEN= # Required for real volunteer instructions: your Mailtrap transactional sending token. Not needed in sandbox.
MAILTRAP_SANDBOX_TOKEN= # API credential for the test inbox. Find it in that Mailtrap Sandbox inbox’s integration settings.
MAILTRAP_INBOX_ID= # Numeric Sandbox inbox ID where volunteer instructions should appear; find it in the inbox integration settings.
